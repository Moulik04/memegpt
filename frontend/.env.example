# Copy this file to .env.local and adjust values if needed.
# .env.local is git-ignored — never commit this file with real values.

# Backend URL (see next.config.js's rewrites() and lib/api.ts)
# BACKEND_URL=http://localhost:8000
# NEXT_PUBLIC_API_BASE=http://localhost:8000

# Supabase Auth (Growth Phase H) — optional accounts on top of the
# anonymous identity in lib/identity.ts. Unset = no sign-in UI, the app is
# exactly Phase C. Both values are public (safe to expose to the browser) —
# get them from Supabase's dashboard under Settings > API.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google's own "Sign in with Google" button (lib/googleIdentity.ts). The
# OAuth web client id from Google Cloud, the same one listed in Supabase's
# Google provider. Public. Unset = sign-in falls back to the redirect flow.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Maintenance mode (see src/middleware.ts). MAINTENANCE_MODE=true serves the
# coming-soon page on every route. MAINTENANCE_BYPASS_SECRET, when set to 24+
# random characters, lets a browser through after it opens any page with
# ?gate=<that value>. Set both in Vercel only, never in a committed file.
# MAINTENANCE_MODE=
# MAINTENANCE_BYPASS_SECRET=

# Google Analytics (GA4). Unset = no analytics loads at all — this is
# deliberately unset in local dev so local/test traffic never reaches real
# GA. Set only in Vercel's production environment variables.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-side only (never NEXT_PUBLIC). The same value as the backend's
# PROXY_SHARED_SECRET. With it set, the /api proxy routes tell the backend
# each visitor's address so its limits count per visitor, and a backend
# that has it refuses Chat, Lore and Make requests arriving without it. See
# src/lib/proxyHeaders.ts. Leave unset on both sides in local development.
# PROXY_SHARED_SECRET=
