# ── MemeGPT environment variables ────────────────────────────────────────────
# Copy this file to .env and fill in values before running.
# For Docker, most of these are overridden by docker-compose.yml environment blocks.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# "ollama"  — local inference (default, free, needs Ollama running)
# "groq"    — cloud inference (free tier, fast, set GROQ_API_KEY below)
LLM_PROVIDER=ollama

# ── Ollama (local LLM) ───────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Groq (cloud LLM, free tier) ──────────────────────────────────────────────
# Get a free API key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# ── Multimodal — image uploads (Phase 0 safety gate + Phase 1 vision) ────────
# See docs/UPLOADS.md. All uploaded images pass through uploads/safe_ingest.py.
# MAX_IMAGE_BYTES=10485760
# MAX_IMAGE_DIMENSION_PX=8000
# MODERATION_MODEL=qwen/qwen3.6-27b
# VISION_PROVIDER=groq
# VISION_MODEL=qwen/qwen3.6-27b
# Optional fallback if Groq vision is unavailable — get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# UPLOAD_RATE_LIMIT=5/minute
# UPLOAD_RETENTION_SECONDS=3600

# ── Multi-context, multi-meme generation — see nlp/segmentation.py ───────────
# MAX_MEMES_PER_REQUEST=5
# MAX_IMAGES_PER_REQUEST=6
# SEGMENTATION_TEXT_THRESHOLD_CHARS=240
# MAX_DUMP_CHARS=20000

# ── Watermark — see backend/image_processing/compositor.py's _draw_watermark() ─
# WATERMARK_ENABLED=true
# WATERMARK_TEXT=memegpt

# ── Durable storage + Postgres (Growth Phase B) — all optional ───────────────
# Unset = local disk storage + no persistence, the fully-functional
# zero-cost default, not a degraded mode. See backend/storage/ and backend/db/.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# ── ChromaDB ─────────────────────────────────────────────────────────────────
# Leave CHROMA_HOST empty → embedded PersistentClient (local dev, no Docker)
# Set CHROMA_HOST=vector-db → HttpClient pointed at the compose service (Docker)
CHROMA_HOST=
CHROMA_PORT=8000

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set CORS_ALLOW_ALL_ORIGINS=true in production (Render/Railway/Cloud)
# Or list specific origins for production:
CORS_ALLOW_ALL_ORIGINS=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000"]
