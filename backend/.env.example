# Copy this file to .env and adjust values if needed.
# .env is git-ignored — never commit this file with real values.

# Ollama — runs locally, completely free, no API key required. Default
# LLM_PROVIDER, no setup needed beyond installing Ollama itself.
# Install: brew install ollama
# Pull model: ollama pull llama3.1:8b
# Start server: ollama serve
#
# Override these only if you're running Ollama on a different host/port
# or want to use a different model (e.g. mistral:7b, llama3.2:3b).
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Groq — cloud inference, free tier (https://console.groq.com). Set
# LLM_PROVIDER=groq to use this instead of local Ollama; also required for
# vision (image description/moderation) and Make's text moderation, since
# neither has a local-Ollama path. GROQ_API_KEY is the only one you need to
# actually set — the rest have working defaults.
# LLM_PROVIDER=ollama
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.6-27b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Server (defaults shown — only set to override)
# HOST=0.0.0.0
# PORT=8000
# DEBUG=false
# CORS_ORIGINS=["http://localhost:3000"]
# Set true in production (Render) instead of listing exact origins.
# CORS_ALLOW_ALL_ORIGINS=false

# Multimodal — image uploads (Phase 0 safety gate + Phase 1 vision). See
# docs/UPLOADS.md. All uploaded images pass through uploads/safe_ingest.py.
# MAX_IMAGE_BYTES=10485760
# MAX_IMAGE_DIMENSION_PX=8000
# MODERATION_MODEL=qwen/qwen3.6-27b
# VISION_PROVIDER=groq
# VISION_MODEL=qwen/qwen3.6-27b
# Optional fallback if Groq vision is unavailable — get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# UPLOAD_RATE_LIMIT=5/minute
# UPLOAD_RETENTION_SECONDS=3600

# Multi-context, multi-meme generation — see nlp/segmentation.py
# MAX_MEMES_PER_REQUEST=5
# MAX_IMAGES_PER_REQUEST=6
# SEGMENTATION_TEXT_THRESHOLD_CHARS=240
# MAX_DUMP_CHARS=20000

# Watermark — see image_processing/compositor.py's _draw_watermark()
# WATERMARK_ENABLED=true
# WATERMARK_TEXT=memegpt

# Durable storage + Postgres (Growth Phase B) — all optional. Unset = local
# disk storage + no persistence, the fully-functional zero-cost default,
# not a degraded mode. See storage/ and db/.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# Supabase Auth (Growth Phase H) — optional accounts on top of the
# anonymous identity above. Unset = no sign-in UI, no behavior change,
# the app is exactly Phase C. See auth.py.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=

# ChromaDB — unset (default) uses an embedded local PersistentClient, fine
# for local dev and even most production setups. Only set CHROMA_HOST if
# you're running ChromaDB as its own service (e.g. docker-compose.yml's
# "vector-db" service, for the full self-hosted stack).
# CHROMA_HOST=
# CHROMA_PORT=8000

# Gemini embeddings — optional. Unset = ChromaDB's local embedding model
# (zero cost, zero config, the default). Only needed on hosts tight on
# memory (e.g. Render's 512MB free tier), since the local embedding model
# alone can OOM there. Free tier: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Discord `/meme` slash command (Growth Phase G) — optional, only needed
# if you're running the Cloudflare Worker in integrations/discord-worker/.
# See docs/DISCORD_SETUP.md. DISCORD_WORKER_SHARED_SECRET is the only one
# this backend actually verifies (a plain pre-shared secret between the
# Worker and this backend) — the others are declared here only so a real
# .env with all four set doesn't get rejected by pydantic-settings' strict
# extra="forbid".
# DISCORD_APP_ID=
# DISCORD_PUBLIC_KEY=
# DISCORD_BOT_TOKEN=
# DISCORD_WORKER_SHARED_SECRET=
# DISCORD_RATE_LIMIT=20/minute
