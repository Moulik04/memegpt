# Ollama Modelfile for the MemeGPT fine-tuned model.
#
# finetune_unsloth.py prints the real output filename at the end of a run
# (whatever Unsloth's GGUF export names it — not a fixed name), so this
# Modelfile standardizes on one fixed filename instead of guessing:
#
#   1. Download the .gguf file finetune_unsloth.py produced, rename it to
#      memegpt.gguf, and place it at this repo's root (same level as this
#      scripts/ directory) — NOT inside the _gguf/ output subdirectory.
#   2. Run (from the repo root): ollama create memegpt -f scripts/Modelfile
#   3. Update backend/config.py: ollama_model = "memegpt"
#   4. Restart uvicorn
#
# Full walkthrough: docs/FINETUNE_RUNBOOK.md

FROM ./memegpt.gguf

SYSTEM """
You are MemeGPT. Given a user message, respond ONLY with a valid JSON object
containing the best meme template and captions:
{"template_id": "<id>", "texts": {"<box>": "<caption>"}, "reasoning": "<why>"}

Be culturally sharp and genuinely funny. Never add explanation outside the JSON.
"""

PARAMETER temperature 0.7
PARAMETER top_p 0.9
PARAMETER num_predict 400
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|end_of_text|>"
